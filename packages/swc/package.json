{
  "name": "@navita/swc",
  "version": "0.1.0",
  "description": "Style extraction transform for Navita",
  "keywords": [
    "css-in-js",
    "navita",
    "oxc"
  ],
  "private": false,
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./src/index.ts"
    }
  },
  "publishConfig": {
    "directory": "dist",
    "linkDirectory": false
  },
  "scripts": {
    "build": "build",
    "dev": "build --dev",
    "test": "vitest run --project @navita/swc",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "magic-string": "^0.30.0",
    "oxc-parser": "^0.137.0",
    "oxc-transform": "^0.137.0"
  },
  "devDependencies": {
    "@navita/adapter": "workspace:*",
    "@navita/css": "workspace:*",
    "@navita/engine": "workspace:*",
    "@navita/types": "workspace:*"
  },
  "license": "MIT",
  "author": "Eagerpatch",
  "repository": {
    "type": "git",
    "url": "https://github.com/eagerpatch/navita.git",
    "directory": "packages/swc"
  }
}
