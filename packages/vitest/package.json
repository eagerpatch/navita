{
  "name": "@navita/vitest",
  "version": "3.0.0-next.4",
  "description": "Vitest tools for Navita",
  "keywords": [
    "vitest",
    "css-in-js",
    "navita"
  ],
  "private": false,
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./src/index.ts"
    }
  },
  "publishConfig": {
    "directory": "dist",
    "linkDirectory": false
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --config-loader unrun --watch",
    "test": "vitest run --project @navita/vitest --passWithNoTests",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@navita/adapter": "workspace:*",
    "@navita/engine": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "vitest": "^4.0.0"
  },
  "license": "MIT",
  "author": "Eagerpatch",
  "repository": {
    "type": "git",
    "url": "https://github.com/eagerpatch/navita.git",
    "directory": "packages/vitest"
  }
}
