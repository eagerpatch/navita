{
  "name": "@navita/jest",
  "version": "3.0.0-next.2",
  "description": "Jest tools for Navita",
  "keywords": [
    "jest",
    "css-in-js",
    "navita"
  ],
  "private": false,
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./src/index.ts"
    }
  },
  "publishConfig": {
    "directory": "dist",
    "linkDirectory": false
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --config-loader unrun --watch",
    "test": "echo \"no tests\"",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@navita/adapter": "workspace:*",
    "@navita/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.1"
  },
  "license": "MIT",
  "author": "Eagerpatch",
  "repository": {
    "type": "git",
    "url": "https://github.com/eagerpatch/navita.git",
    "directory": "packages/jest"
  }
}
