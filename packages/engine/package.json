{
  "name": "@navita/engine",
  "version": "3.0.0-next.2",
  "description": "Navitas CSS-in-JS engine",
  "keywords": [
    "css-in-js",
    "engine",
    "navita"
  ],
  "private": false,
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./src/index.ts"
    }
  },
  "publishConfig": {
    "directory": "dist",
    "linkDirectory": false
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --config-loader unrun --watch",
    "test": "vitest run --project @navita/engine",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "sort-css-media-queries": "2.4.0",
    "@emotion/hash": "0.9.2",
    "source-map": "0.7.4"
  },
  "devDependencies": {
    "@navita/types": "workspace:*"
  },
  "license": "MIT",
  "author": "Eagerpatch",
  "repository": {
    "type": "git",
    "url": "https://github.com/eagerpatch/navita.git",
    "directory": "packages/engine"
  }
}
