{
  "compilerOptions": {
    "strict": false,
    "strictBindCallApply": true,
    "target": "es2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "exclude": ["**/dist"]
}
